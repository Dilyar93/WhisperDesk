/* WhisperDesk custom QSS
   与 pyqtdarktheme 的深色主题叠加使用，只覆盖关键控件。 */

QMainWindow {
    background: #1e1f22;
}

QLabel {
    color: #dddee1;
    font-size: 14px;
}

/* ---------- 拖放区 ---------- */
QFrame#DropArea {
    border: 2px dashed #3a3d42;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.02);
}
QFrame#DropArea[dragging="true"] {
    border: 2px dashed #4f8cff;
    background: rgba(79, 140, 255, 0.08);
}
QLabel#DropTitle {
    font-size: 20px;
    font-weight: 600;
    color: #ffffff;
}
QLabel#DropHint {
    font-size: 12px;
    color: #8a8f98;
}
QLabel#DropCurrent {
    font-size: 12px;
    color: #4f8cff;
}

/* ---------- 按钮 ---------- */
QPushButton {
    background: #2b2d31;
    color: #e6e7ea;
    border: 1px solid #3a3d42;
    border-radius: 8px;
    padding: 8px 18px;
    font-size: 14px;
    min-width: 72px;
}
QPushButton:hover {
    background: #34363b;
    border-color: #4a4d52;
}
QPushButton:pressed {
    background: #26282c;
}
QPushButton:disabled {
    color: #5a5d62;
    background: #26282c;
    border-color: #2f3136;
}
QPushButton#Primary {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #4f8cff, stop:1 #3a7bff);
    color: white;
    border: none;
    font-weight: 600;
}
QPushButton#Primary:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #5a97ff, stop:1 #4786ff);
}
QPushButton#Primary:pressed {
    background: #3a7bff;
}

/* ---------- 进度条 ---------- */
QProgressBar {
    background: #2a2c30;
    border: 1px solid #36383d;
    border-radius: 10px;
    height: 20px;
    text-align: center;
    color: #ffffff;
    font-size: 12px;
}
QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #4f8cff, stop:1 #7aa8ff);
    border-radius: 10px;
}

/* ---------- 下拉 / 输入 ---------- */
QComboBox, QLineEdit, QSpinBox {
    background: #2a2c30;
    border: 1px solid #3a3d42;
    border-radius: 6px;
    padding: 5px 8px;
    color: #e6e7ea;
}
QComboBox:hover, QLineEdit:hover, QSpinBox:hover {
    border-color: #4a4d52;
}
QComboBox::drop-down { border: none; width: 22px; }

/* ---------- 结果文本框 ---------- */
QTextEdit#Result {
    background: #202125;
    border: 1px solid #2f3136;
    border-radius: 10px;
    padding: 10px;
    color: #e6e7ea;
    font-family: "Cascadia Mono", "Consolas", "JetBrains Mono", "Menlo", monospace;
    font-size: 13px;
    selection-background-color: #4f8cff;
}

/* ---------- 菜单/对话框 ---------- */
QDialog {
    background: #1e1f22;
}
QCheckBox {
    color: #e6e7ea;
    spacing: 6px;
}
